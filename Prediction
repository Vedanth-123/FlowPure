"""
Module: src.pinn.predictor
Description: Production-grade PINN inference engine for the flowpure-control_systems 
             repository, managing STP wastewater telemetry normalization and Monte Carlo uncertainty.
"""

import os
import logging
from typing import Tuple, List, Union
import numpy as np
import pandas as pd
import tensorflow as tf

# Configure standard logging for industrial auditability and backend tracking
logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] [%(name)s] %(message)s")
logger = logging.getLogger("FlowPurePredictor")

class FlowPurePredictor:
    """
    Inference wrapper for the flowpure-control_systems PINN model.
    Handles real-time STP wastewater sensor telemetry normalization, forward passes,
    and epistemic uncertainty quantification via Monte Carlo dropout.
    """
    def __init__(
        self, 
        model_path_candidates: List[str] = None, 
        telemetry_dataset_path: str = 'water_telemetry_test_set.xlsx'
    ):
        os.environ["TF_USE_LEGACY_KERAS"] = "1"
        self.model_path_candidates = model_path_candidates or [
            'models/flowpure_brain.h5',
            'flowpure_brain.h5',
            'models/flowpure_brain_weights.h5',
            'flowpure_brain_weights.h5'
        ]
        self.telemetry_dataset_path = telemetry_dataset_path
        
        # Initialize model architecture and load dependencies
        self.model = self._initialize_model_architecture()
        self._load_model_weights()
        self.feat_min, self.feat_max = self._load_scaling_boundaries()

    def _initialize_model_architecture(self) -> tf.keras.Model:
        """Constructs the baseline neural network architecture matching training specifications."""
        logger.info("Initializing PINN neural network architecture...")
        model = tf.keras.Sequential([
            tf.keras.layers.Input(shape=(5,)),
            tf.keras.layers.Dense(64, activation='swish', kernel_initializer='he_normal'),
            tf.keras.layers.Dropout(0.1),
            tf.keras.layers.Dense(64, activation='swish', kernel_initializer='he_normal'),
            tf.keras.layers.Dropout(0.1),
            tf.keras.layers.Dense(1)
        ])
        model.build(input_shape=(None, 5))
        return model

    def _load_model_weights(self) -> None:
        """Iterates through candidate file paths to safely load pre-trained model weights."""
        is_loaded = False
        for path in self.model_path_candidates:
            if os.path.exists(path):
                try:
                    self.model.load_weights(path)
                    logger.info(f"Successfully loaded pre-trained PINN weights from: {path}")
                    is_loaded = True
                    break
                except Exception as e:
                    logger.error(f"Failed to load weights from {path}: {e}")
        
        if not is_loaded:
            logger.warning("No pre-trained weight files found in standard paths. Initialized with random weights.")

    def _load_scaling_boundaries(self) -> Tuple[np.ndarray, np.ndarray]:
        """Loads normalization extrema from telemetry datasets or resorts to physical fallback limits."""
        if os.path.exists(self.telemetry_dataset_path):
            try:
                telemetry_df = pd.read_excel(self.telemetry_dataset_path)
                train_features = telemetry_df[['LIT_101', 'FIT_101', 'Turbidity_Raw', 'TDS_Feed']].values.astype('float32')
                feat_min = train_features.min(axis=0)
                feat_max = train_features.max(axis=0)
                logger.info(f"Loaded scaling boundaries successfully from {self.telemetry_dataset_path}.")
                return feat_min, feat_max
            except Exception as e:
                logger.error(f"Error reading telemetry dataset for scaling limits: {e}")
        
        logger.warning("Telemetry dataset missing or unreadable. Falling back to default physical boundary limits.")
        feat_min = np.array([447.0, 0.1, 84.0, 6400.0], dtype='float32')
        feat_max = np.array([1000.0, 0.9, 213.0, 8100.0], dtype='float32')
        return feat_min, feat_max

    def predict_stp_tank_depth(
        self, 
        elapsed_time: float, 
        sensor_readings: Union[List[float], np.ndarray], 
        num_mc_samples: int = 10
    ) -> Tuple[float, float]:
        """
        Takes raw real-time IoT sensor inputs, normalizes metrics against training bounds, 
        and predicts STP tank depth with Monte Carlo sampling for uncertainty quantification.

        Args:
            elapsed_time (float): Current STP cycle time step or chronological progress value.
            sensor_readings (list or np.ndarray): Raw sensor telemetry array containing 
                [LIT_101, FIT_101, Turbidity_Raw, TDS_Feed].
            num_mc_samples (int, optional): Number of stochastic Monte Carlo passes 
                for epistemic uncertainty estimation. Defaults to 10.

        Returns:
            Tuple[float, float]: A tuple containing (mean_predicted_depth, epistemic_uncertainty_std).
        """
        sensor_vector = np.array(sensor_readings, dtype='float32')
        if sensor_vector.size != 4:
            raise ValueError(f"Expected 4 sensor values, got {sensor_vector.size}. Expected format: [LIT_101, FIT_101, Turbidity_Raw, TDS_Feed]")

        # Normalize incoming IoT telemetry against boundary limits
        normalized_sensors = (sensor_vector.reshape(1, -1) - self.feat_min) / (self.feat_max - self.feat_min + 1e-8)
        
        # Format temporal input tensor
        time_tensor = np.array([[elapsed_time]], dtype='float32')
        
        # Combine time and normalized sensors -> Shape (1, 5) [Time, Level, Flow, Turbidity, TDS]
        combined_input = tf.concat([time_tensor, normalized_sensors], axis=1)
        
        # Vectorized Monte Carlo batch expansion (Runs all stochastic passes concurrently)
        batched_input = tf.tile(combined_input, [num_mc_samples, 1])
        
        # training=True keeps Dropout active to capture epistemic uncertainty bounds
        mc_predictions = self.model(batched_input, training=True).numpy()
        
        predicted_mean_depth = float(np.mean(mc_predictions))
        epistemic_uncertainty = float(np.std(mc_predictions))
        
        return predicted_mean_depth, epistemic_uncertainty


# --- EXECUTION TEST ---
if __name__ == "__main__":
    predictor = FlowPurePredictor()
    
    sample_time = 5.5
    # Input telemetry: [Level (mm), Flow (L/min), Turbidity (NTU), TDS (ppm)]
    sample_sensors = [680.0, 0.2, 112.0, 6900.0] 

    predicted_h, std_dev = predictor.predict_stp_tank_depth(sample_time, sample_sensors)
    logger.info(f"Prediction Result -> Depth: {predicted_h:.3f}m | Uncertainty: ±{std_dev:.4f}")
